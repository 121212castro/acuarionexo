{
  "name": "acuarionexo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:refresh": "node scripts/refresh-project-docs.mjs",
    "check": "npm run docs:refresh && node scripts/validate-app.mjs",
    "mobile:prepare": "npm run docs:refresh && node scripts/prepare-mobile-bundle.mjs",
    "mobile:check": "node scripts/validate-mobile-bundle.mjs",
    "mobile:sync": "npm run mobile:prepare && npm run mobile:check && npx cap sync",
    "mobile:add:android": "npm run mobile:prepare && npm run mobile:check && npx cap add android",
    "mobile:add:ios": "npm run mobile:prepare && npm run mobile:check && npx cap add ios",
    "mobile:open:android": "npx cap open android",
    "mobile:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/ios": "latest",
    "@capacitor/preferences": "latest",
    "@capacitor/push-notifications": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest"
  }
}
